{
  // TypeScript settings for the browser side of the app.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], // browser globals: window, document, fetch
    "module": "ESNext",
    "moduleResolution": "bundler",            // Vite resolves imports, not tsc
    "jsx": "react-jsx",                       // no need to `import React` in every file
    "strict": true,
    "noEmit": true,                           // Vite does the actual building; tsc only type-checks
    "skipLibCheck": true,
    "isolatedModules": true,                  // each file compiles independently, which Vite requires
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
