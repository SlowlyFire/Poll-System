# Copy to .env for local overrides. Nothing here is secret — this app has no API keys,
# no database password and no auth, so there is nothing to leak. .env is still gitignored,
# because the moment a project does have a secret, the habit needs to already be in place.

# Port the server listens on. Railway sets this itself; do not set it there.
PORT=3001

# Where the SQLite file lives.
#   locally: a file in the server folder
#   Railway: a path inside the mounted volume, e.g. /data/poll.db
# If this points anywhere outside the volume in production, the database is wiped on
# every single redeploy.
DB_PATH=poll.db
